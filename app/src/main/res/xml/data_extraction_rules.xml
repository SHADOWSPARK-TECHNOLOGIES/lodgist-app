<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the local Room database (leads, payment requests) on this device only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="lodgist_database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="lodgist_database" />
    </device-transfer>
</data-extraction-rules>
